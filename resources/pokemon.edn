;; The Pokemon database as it grew over the games, one transaction per generation.
;; Each transaction says which generation it records and when those games were released.
;; Datomic's own timestamps only say when this file was loaded.
;; Sources: https://pokemondb.net/tools/text-list, https://pokeapi.co (past_stats, past_types)
[
;; Schema
[{:db/ident :pokemon/number
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity}
 {:db/ident :pokemon/name
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}
 {:db/ident :pokemon/type
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/many}
 {:db/ident :stat/hp
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one}
 {:db/ident :stat/attack
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one}
 {:db/ident :stat/defense
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one}
 {:db/ident :stat/sp-attack
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one}
 {:db/ident :stat/sp-defense
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one}
 {:db/ident :stat/speed
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one}
 {:db/ident :pokemon/category
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc "Legendary, Mythical, etc"}
 {:db/ident :evolution/next
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc "The Pokemon this one evolves into"}
 {:db/ident :type/name
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "A Pokemon type, spelled like the values of :pokemon/type"}
 {:db/ident :type/strong-against
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc "The types this type deals double damage to"}
 {:db/ident :type/weak-against
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc "The types this type deals half damage to"}
 {:db/ident :type/no-effect-on
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc "The types this type deals no damage to"}
 {:db/ident :stat/special
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "Generation I's single Special stat, split into sp-attack and sp-defense in Generation II"}
 {:db/ident :tx/generation
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "The game generation whose changes a transaction records"}
 {:db/ident :tx/released
  :db/valueType :db.type/instant
  :db/cardinality :db.cardinality/one
  :db/doc "When the games of that generation were first released"}]

;; Generation I (1996): a single Special stat, 15 types
[{:db/id "datomic.tx" :tx/generation "Generation I" :tx/released #inst "1996-02-27"}

