 {:db/id "t-Rock" :type/name "Rock" :type/strong-against ["t-Bug" "t-Fire" "t-Flying" "t-Ice"] :type/weak-against ["t-Fighting" "t-Ground"]}
 {:db/id "t-Water" :type/name "Water" :type/strong-against ["t-Fire" "t-Ground" "t-Rock"] :type/weak-against ["t-Dragon" "t-Grass" "t-Water"]}

